# Existing voice providers
GROQ_API_KEY=replace_with_your_groq_key
DEEPGRAM_API_KEY=replace_with_your_deepgram_key

# Optional ordered fallback models. Omit to use these defaults.
# GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b

# Optional: set false to disable live web search. Enabled when unset.
ENABLE_WEB_SEARCH=false
