# Existing voice providers
GROQ_API_KEY=replace_with_your_groq_key
DEEPGRAM_API_KEY=replace_with_your_deepgram_key

# Paid Maps APIs are OFF. Keep this false for zero-cost operation.
ENABLE_PAID_MAPS=false
# Gmail uses native Android OAuth; no Gmail environment variables are needed.
# Installed Maps needs no API key or client token.
# Leave GOOGLE_MAPS_API_KEY and MAPS_CLIENT_TOKEN unset for this setup.
